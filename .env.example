# Google Sheet backend: Web app URL of apps-script/Code.gs (ends in /exec) and the TOKEN set in that script
SHEETS_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_API_TOKEN=same-value-as-TOKEN-in-the-apps-script
# Emails that get the marketing role (comma-separated). Everyone else signs in as commercial.
MARKETING_EMAILS=zakaria.lahmaid@jumia.com
# Email domains allowed to sign in (comma-separated). Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAINS=jumia.com
# Optional: timezone used for "today" and history times (default Africa/Casablanca)
APP_TIMEZONE=Africa/Casablanca
